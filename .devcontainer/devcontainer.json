{
  "name": "ISPPOS Expo Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Expo / Metro",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "postCreateCommand": "npm ci",
  "remoteEnv": {
    "EXPO_NO_TELEMETRY": "1"
  }
}
